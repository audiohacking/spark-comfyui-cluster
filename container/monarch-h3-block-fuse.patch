--- /dev/null
+++ b/src/dgx_monarch/kernels/h3_block_fuse.py
@@ -0,0 +1,240 @@
+"""MiniMax H3's DiTBlock.forward with its small operations fused.
+
+Stock runs the norms, adaLN modulation, gates and residuals as separate kernels,
+launching one set per modulation segment: a rank holding the text rows launches
+thousands per step. `h3_block_fuse_triton` does the same arithmetic in three
+kernels per block, indexed by a per-row table.
+
+Kernel replacement rules (docs/DESIGN.md section 4): identical output, an off
+switch, and the stock path whenever a prerequisite is missing. The first
+forward at a given width compiles the kernels and compares them bit for bit
+with the stock operations on small tensors in this very process; a difference
+or a compile failure leaves the process on stock with one warning. Attention
+and the MLP are the stock modules, called exactly as before.
+`DGXM_H3_BLOCK_FUSE=off` in the Worker's environment turns it off.
+"""
+from __future__ import annotations
+
+import functools
+import os
+
+from ..log import get_logger
+
+log = get_logger(__name__)
+
+ENV = "DGXM_H3_BLOCK_FUSE"
+
+
+class _State:
+    installed = False
+    checked: dict = {}
+    kernels = None
+    warned = 0
+    fused = 0
+    ridx_key = None
+    ridx = None
+
+
+_STATE = _State()
+
+
+def enabled() -> bool:
+    return os.environ.get(ENV, "").strip().lower() != "off"
+
+
+def _note(reason: str) -> None:
+    _STATE.warned += 1
+    if _STATE.warned <= 3:
+        log.warning("H3 block fusion: stock path, %s", reason)
+
+
+def _row_index(segments, rows, device):
+    """Per-row int32 modulation index, or None when `segments` do not cover the rows.
+
+    The blocks of one forward share one list, so the last table is kept; the key
+    holds the list itself, which stops its id being reused."""
+    import torch
+
+    key = _STATE.ridx_key
+    if key is not None and key[0] is segments and key[1] == rows and key[2] == device:
+        return _STATE.ridx
+    ordered = sorted(segments, key=lambda seg: seg[0])
+    position = 0
+    for start, stop, row in ordered:
+        if start != position or stop < start:
+            return None
+        if torch.is_tensor(row) and row.numel() != stop - start:
+            return None
+        position = stop
+    if position != rows:
+        return None
+    table = torch.empty(rows, dtype=torch.int32, device=device)
+    for start, stop, row in ordered:
+        table[start:stop] = (row.to(device=device, dtype=torch.int32) if torch.is_tensor(row)
+                             else int(row))
+    _STATE.ridx_key, _STATE.ridx = (segments, rows, device), table
+    return table
+
+
+def _both_blocks(model, kernels, x, weight, eps, segments, table, others, vectors):
+    """One block's arithmetic, stock against fused, on the same inputs."""
+    import torch.nn.functional as functional
+
+    width = x.shape[1]
+    shift_a, scale_a, gate_a, shift_m, scale_m, gate_m = vectors
+    other_a, other_m = others
+    stock_x = x.clone()
+    stock_1 = model._mod_scale_shift(functional.rms_norm(stock_x, (width,), weight, eps),
+                                     shift_a, scale_a, segments)
+    model._mod_gate(stock_x, gate_a, other_a, segments)
+    stock_2 = model._mod_scale_shift(functional.rms_norm(stock_x, (width,), weight, eps),
+                                     shift_m, scale_m, segments)
+    model._mod_gate(stock_x, gate_m, other_m, segments)
+    fused_x = x.clone()
+    fused_1 = kernels.norm_mod(fused_x, weight, eps, table, (1.0 + scale_a).contiguous(), shift_a.contiguous())
+    fused_2 = kernels.gate_norm_mod_(fused_x, other_a, gate_a.contiguous(), weight, eps, table,
+                                     (1.0 + scale_m).contiguous(), shift_m.contiguous())
+    kernels.gate_(fused_x, other_m, gate_m.contiguous(), table)
+    return (stock_1, stock_2, stock_x), (fused_1, fused_2, fused_x)
+
+
+def self_check(model, width, eps, device) -> str | None:
+    """None when the kernels equal stock bit for bit at this width, else why not."""
+    import torch
+
+    try:
+        if _STATE.kernels is None:
+            from . import h3_block_fuse_triton
+
+            _STATE.kernels = h3_block_fuse_triton
+        generator = torch.Generator().manual_seed(width)
+        for rows in (1, 7, 64):
+            for scale in (1.0, 30.0, 0.02):
+                def tensor(shape, factor):
+                    return (torch.randn(shape, generator=generator) * factor).to(torch.bfloat16).to(device)
+
+                x = tensor((rows, width), scale)
+                others = tensor((rows, width), scale), tensor((rows, width), scale)
+                weight = (1 + tensor((width,), 0.3).to(torch.float32)).to(torch.bfloat16)
+                vectors = [tensor((12, width), 0.3) for _ in range(6)]
+                cut = rows // 2
+                by_token = torch.randint(0, 12, (rows - cut,), generator=generator).to(device)
+                segments = [(0, cut, 3), (cut, rows, by_token)] if cut else [(0, rows, by_token)]
+                table = torch.empty(rows, dtype=torch.int32, device=device)
+                for start, stop, row in segments:
+                    table[start:stop] = row.to(dtype=torch.int32) if torch.is_tensor(row) else row
+                stock, fused = _both_blocks(model, _STATE.kernels, x, weight, eps, segments, table, others, vectors)
+                for a, b in zip(stock, fused, strict=True):
+                    if not torch.equal(a.view(torch.int16), b.view(torch.int16)):
+                        return f"kernels differ from stock at width {width}, {rows} rows"
+    except Exception as exc:  # noqa: BLE001
+        return f"kernels unavailable ({exc!r:.200})"
+    return None
+
+
+def _approved(model, width, eps, device) -> bool:
+    key = (width, eps, str(device))
+    if key not in _STATE.checked:
+        reason = self_check(model, width, eps, device)
+        _STATE.checked[key] = reason is None
+        if reason:
+            log.warning("H3 block fusion: stock path for this process, %s", reason)
+        else:
+            log.info("H3 block fusion: active (bit-identical to stock at width %d)", width)
+    return _STATE.checked[key]
+
+
+class _Plain:
+    def __init__(self, weight):
+        self.weight = weight
+
+    def __enter__(self):
+        return self.weight, None
+
+    def __exit__(self, *args):
+        return False
+
+
+def _weight(norm, x):
+    """The weight as comfy.ops' RMSNorm.forward would get it, in a context."""
+    if norm.comfy_cast_weights or len(norm.weight_function) > 0 or len(norm.bias_function) > 0:
+        return norm.cast_weight(x)
+    return _Plain(norm.weight)
+
+
+def install() -> bool:
+    """Wrap DiTBlock.forward once. Never raises; False leaves stock in place."""
+    if _STATE.installed:
+        return True
+    try:
+        import comfy.ldm.minimax.model as model
+        import comfy.ops
+        import torch
+    except Exception as exc:  # noqa: BLE001
+        log.warning("H3 block fusion: not installed (%r)", exc)
+        return False
+    original = model.DiTBlock.forward
+    bf16 = torch.bfloat16
+    tick = getattr(comfy.ops, "run_every_op", None)
+
+    @functools.wraps(original)
+    def forward(self, x, t_emb, mod_segments, rope_freqs, transformer_options={}, attention=None):  # noqa: B006
+        def stock(reason=None):
+            if reason:
+                _note(reason)
+            return original(self, x, t_emb, mod_segments, rope_freqs,
+                            transformer_options=transformer_options, attention=attention)
+
+        if not enabled():
+            return stock()
+        n1, n2 = self.norm1, self.norm2
+        if not (x.dim() == 2 and x.is_cuda and x.dtype == bf16 and x.is_contiguous()
+                and x.data_ptr() % 16 == 0 and x.shape[1] % 4 == 0
+                and n1.eps is not None and n2.eps is not None and n1.eps == n2.eps
+                and tuple(n1.normalized_shape) == (x.shape[1],)
+                and tuple(n2.normalized_shape) == (x.shape[1],)
+                and not torch.is_grad_enabled()):
+            return stock(f"x {tuple(x.shape)} {x.dtype}")
+        if not _approved(model, x.shape[1], float(n1.eps), x.device):
+            return stock()
+        table = _row_index(mod_segments, x.shape[0], x.device)
+        if table is None:
+            return stock("modulation segments do not cover the rows")
+        kernels = _STATE.kernels
+        attention_fn = self.attn if attention is None else attention
+        shift_a, scale_a, gate_a, shift_m, scale_m, gate_m = self.adaln_proj(t_emb)
+        scale_a1, shift_a_f = (1.0 + scale_a.to(bf16)).contiguous(), shift_a.to(bf16).contiguous()
+        if tick is not None:
+            tick()
+        with _weight(n1, x) as (w1, _):
+            if w1 is None or w1.dtype != bf16 or not w1.is_contiguous():
+                return stock("norm weight not plain bf16")
+            h = kernels.norm_mod(x, w1, float(n1.eps), table, scale_a1, shift_a_f)
+        o = attention_fn(h, rope_freqs=rope_freqs, transformer_options=transformer_options)
+        del h
+        if not o.is_contiguous():
+            o = o.contiguous()
+        if tick is not None:
+            tick()
+        with _weight(n2, x) as (w2, _):
+            if w2 is None or w2.dtype != bf16 or not w2.is_contiguous():
+                # x is untouched so far: finish this block the stock way.
+                _note("second norm weight not plain bf16")
+                model._mod_gate(x, gate_a, o, mod_segments)
+                h = model._mod_scale_shift(n2(x), shift_m, scale_m, mod_segments)
+            else:
+                h = kernels.gate_norm_mod_(x, o, gate_a.to(bf16).contiguous(), w2, float(n2.eps), table,
+                                           (1.0 + scale_m.to(bf16)).contiguous(), shift_m.to(bf16).contiguous())
+        del o
+        o = self.mlp(h)
+        del h
+        if not o.is_contiguous():
+            o = o.contiguous()
+        kernels.gate_(x, o, gate_m.to(bf16).contiguous(), table)
+        _STATE.fused += 1
+        return x
+
+    forward._h3_block_fuse = True
+    model.DiTBlock.forward = forward
+    _STATE.installed = True
+    return True
