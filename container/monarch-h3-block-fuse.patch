+"""Triton kernels fusing the small operations of MiniMax H3's DiTBlock.
+
+Vendored under the MIT license above from minimax-h3-multi-dgx-spark,
+comfyui_nodes/h3-fuse-graph/h3_fuse_kernels.py; comments translated, and the
+Python-header search removed because the image ships the headers.
+
+Stock DiTBlock.forward runs one RMSNorm kernel, then per segment a multiply and
+an add, and per segment one addcmul. Fused:
+  norm_mod        h = (rmsnorm(x) * s1[row]) + shift[row]
+  gate_norm_mod_  x = x + o * g[row], and h as above from that x
+  gate_           x = x + o * g[row]
+Rounding to bf16 happens at the same points as stock (the norm's output, after
+the multiply, after the add, after the residual), and the RMSNorm sum of squares
+adds in the same order as PyTorch's vectorized_layer_norm_kernel. h3_block_fuse
+checks that bit for bit in each process before using them.
+"""
+import torch
+import triton
+import triton.language as tl
+
+NUMX = 128   # PyTorch num_threads() (32 warps x 4)
+VEC = 4      # vec_size of PyTorch's vectorized_layer_norm_kernel
+
+
+@triton.jit
+def _cols4(t):
+    t = tl.reshape(t, [t.shape[0], 2, 2])
+    e, o = tl.split(t)
+    c0, c2 = tl.split(e)
+    c1, c3 = tl.split(o)
+    return c0, c1, c2, c3
+
+
+@triton.jit
+def _sumsq4(acc, t):
+    c0, c1, c2, c3 = _cols4(t)
+    acc = acc + c0 * c0
+    acc = acc + c1 * c1
+    acc = acc + c2 * c2
+    acc = acc + c3 * c3
+    return acc
+
+
+@triton.jit
+def _tree128(acc):
+    s = tl.reshape(acc, [4, 32])
+    s = tl.sum(tl.reshape(s, [4, 2, 16]), axis=1)
+    s = tl.sum(tl.reshape(s, [4, 2, 8]), axis=1)
+    s = tl.sum(tl.reshape(s, [4, 2, 4]), axis=1)
+    s = tl.sum(tl.reshape(s, [4, 2, 2]), axis=1)
+    s = tl.sum(tl.reshape(s, [4, 2, 1]), axis=1)
+    s = tl.reshape(s, [4])
+    s = tl.sum(tl.reshape(s, [2, 2]), axis=0)   # warp y and y+2
+    return tl.sum(s, axis=0)                    # warps 0 and 1
+
+
+@triton.jit
+def _rbf16(v):
+    # f32 -> bf16 round-to-nearest-even, returned as f32. Written as integer math because
+    # .to(bf16).to(f32) is folded away by Triton, which then fuses the next mul/add into an FMA.
+    u = v.to(tl.uint32, bitcast=True)
+    u = u + 0x7FFF + ((u >> 16) & 1)
+    u = (u >> 16) << 16
+    return u.to(tl.float32, bitcast=True)
+
+
+@triton.jit
+def _norm_mod_kernel(X, W, RIDX, S1, SH, H, N, eps, ITERS: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    r = tl.load(RIDX + row).to(tl.int64)
+    xb = X + row * N
+    hb = H + row * N
+    s1b = S1 + r * N
+    shb = SH + r * N
+    t = tl.arange(0, 128)
+    v = tl.arange(0, 4)
+    acc = tl.zeros([128], tl.float32)
+    for it in tl.static_range(ITERS):
+        idx = (it * 128 + t)[:, None] * 4 + v[None, :]
+        x = tl.load(xb + idx, mask=idx < N, other=0.0).to(tl.float32)
+        acc = _sumsq4(acc, x)
+    tot = _tree128(acc)
+    rstd = tl.math.rsqrt(tl.math.div_rn(tot, N.to(tl.float32)) + eps)
+    for it in tl.static_range(ITERS):
+        idx = (it * 128 + t)[:, None] * 4 + v[None, :]
+        m = idx < N
+        x = tl.load(xb + idx, mask=m, other=0.0).to(tl.float32)
+        w = tl.load(W + idx, mask=m, other=0.0).to(tl.float32)
+        y = _rbf16(w * (rstd * x))
+        s1 = tl.load(s1b + idx, mask=m, other=0.0).to(tl.float32)
+        sh = tl.load(shb + idx, mask=m, other=0.0).to(tl.float32)
+        y = _rbf16(y * s1)
+        tl.store(hb + idx, (y + sh).to(tl.bfloat16), mask=m)
+
+
+@triton.jit
+def _gate_norm_mod_kernel(X, O, G, W, RIDX, S1, SH, H, N, eps, ITERS: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    r = tl.load(RIDX + row).to(tl.int64)
+    xb = X + row * N
+    ob = O + row * N
+    hb = H + row * N
+    gb = G + r * N
+    s1b = S1 + r * N
+    shb = SH + r * N
+    t = tl.arange(0, 128)
+    v = tl.arange(0, 4)
+    acc = tl.zeros([128], tl.float32)
+    # First pass: only the sum of squares of the updated x (x is not written yet).
+    for it in tl.static_range(ITERS):
+        idx = (it * 128 + t)[:, None] * 4 + v[None, :]
+        m = idx < N
+        x = tl.load(xb + idx, mask=m, other=0.0).to(tl.float32)
+        o = tl.load(ob + idx, mask=m, other=0.0).to(tl.float32)
+        g = tl.load(gb + idx, mask=m, other=0.0).to(tl.float32)
+        xn = _rbf16(x + o * g)
+        acc = _sumsq4(acc, xn)
+    tot = _tree128(acc)
+    rstd = tl.math.rsqrt(tl.math.div_rn(tot, N.to(tl.float32)) + eps)
+    # Second pass: recompute the same values and write x and h.
+    for it in tl.static_range(ITERS):
+        idx = (it * 128 + t)[:, None] * 4 + v[None, :]
+        m = idx < N
+        x = tl.load(xb + idx, mask=m, other=0.0).to(tl.float32)
+        o = tl.load(ob + idx, mask=m, other=0.0).to(tl.float32)
+        g = tl.load(gb + idx, mask=m, other=0.0).to(tl.float32)
+        xn = _rbf16(x + o * g)
+        tl.store(xb + idx, xn.to(tl.bfloat16), mask=m)
+        w = tl.load(W + idx, mask=m, other=0.0).to(tl.float32)
+        y = _rbf16(w * (rstd * xn))
+        s1 = tl.load(s1b + idx, mask=m, other=0.0).to(tl.float32)
+        sh = tl.load(shb + idx, mask=m, other=0.0).to(tl.float32)
+        y = _rbf16(y * s1)
+        tl.store(hb + idx, (y + sh).to(tl.bfloat16), mask=m)
+
+
+@triton.jit
+def _gate_kernel(X, O, G, RIDX, N, BLOCK: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    col = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    m = col < N
+    r = tl.load(RIDX + row).to(tl.int64)
+    x = tl.load(X + row * N + col, mask=m, other=0.0).to(tl.float32)
+    o = tl.load(O + row * N + col, mask=m, other=0.0).to(tl.float32)
+    g = tl.load(G + r * N + col, mask=m, other=0.0).to(tl.float32)
+    tl.store(X + row * N + col, (x + o * g).to(tl.bfloat16), mask=m)
+
+
+def _iters(n):
+    return triton.cdiv(triton.cdiv(n, VEC), NUMX)
+
+
+def norm_mod(x, w, eps, ridx, s1, sh):
+    s, n = x.shape
+    h = torch.empty_like(x)
+    _norm_mod_kernel[(s,)](x, w, ridx, s1, sh, h, n, eps, ITERS=_iters(n), num_warps=4)
+    return h
+
+
+def gate_norm_mod_(x, o, g, w, eps, ridx, s1, sh):
+    s, n = x.shape
+    h = torch.empty_like(x)
+    _gate_norm_mod_kernel[(s,)](x, o, g, w, ridx, s1, sh, h, n, eps, ITERS=_iters(n), num_warps=4)
+    return h
+
+
+def gate_(x, o, g, ridx):
+    s, n = x.shape
+    block = 1024
+    _gate_kernel[(s, triton.cdiv(n, block))](x, o, g, ridx, n, BLOCK=block, num_warps=4)
+    return x
