@@ -0,0 +1,40 @@
+"""H3 DiTBlock fusion: the off switch and the row table. Bit equality
+with stock is checked by self_check in each process, on the GPU."""
+import pytest
+import torch
+
+from dgx_monarch.kernels import h3_block_fuse as fuse
+
+
+@pytest.fixture(autouse=True)
+def reset():
+    fuse._STATE.ridx_key = fuse._STATE.ridx = None
+
+
+def test_on_unless_switched_off(monkeypatch):
+    monkeypatch.delenv(fuse.ENV, raising=False)
+    assert fuse.enabled()
+    monkeypatch.setenv(fuse.ENV, "off")
+    assert not fuse.enabled()
+
+
+def test_row_table_mixes_runs_and_per_token_rows():
+    segments = [(2, 4, torch.tensor([5, 6])), (0, 2, 1)]
+    assert fuse._row_index(segments, 4, "cpu").tolist() == [1, 1, 5, 6]
+
+
+@pytest.mark.parametrize("segments", [
+    [(0, 2, 1)],
+    [(1, 4, 1)],
+    [(0, 2, 1), (3, 4, 1)],
+    [(0, 4, torch.tensor([1, 2]))],
+])
+def test_row_table_refuses_gaps_and_short_rows(segments):
+    assert fuse._row_index(segments, 4, "cpu") is None
+
+
+def test_row_table_is_reused_only_for_the_same_list():
+    segments = [(0, 4, 1)]
+    first = fuse._row_index(segments, 4, "cpu")
+    assert fuse._row_index(segments, 4, "cpu") is first
+    assert fuse._row_index([(0, 4, 1)], 4, "cpu") is not first
