+def _preview_x0(x0):
+    """spark-comfyui-cluster: the leader's x0 for the driver's live preview.
+
+    The first stream of a nested latent (the picture), detached to CPU fp16:
+    a few MB a step, small next to a step's compute. Never raises; a preview
+    that cannot be taken is a step without one.
+    """
+    try:
+        if x0 is None:
+            return None
+        if getattr(x0, "is_nested", False) or hasattr(x0, "unbind") and type(x0).__name__ == "NestedTensor":
+            x0 = x0.unbind()[0]
+        return x0.detach().to("cpu", torch.float16)
+    except Exception:
+        return None
+
+
 def make_progress_callback(progress_port, total_steps: int, cancel_event=None):
     """Stream leader progress and observe driver cancellation on every rank."""
