diff --git a/src/dgx_monarch/topology.py b/src/dgx_monarch/topology.py
index f816941..6b62460 100644
--- a/src/dgx_monarch/topology.py
+++ b/src/dgx_monarch/topology.py
@@ -282,6 +282,17 @@ def choose_auto_topology(
         topo_kwargs["fsdp"] = True
     topo = Topology(world=world, **topo_kwargs)  # type: ignore[arg-type]
 
+    if world > 2 and batch_size == 1 and world > topo.model_parallel:
+        # Every table row is a two-rank layout. A batch-1 render on a larger
+        # world spreads over all of it with Ulysses: the USP attention wrapper
+        # pads the heads to a multiple of the degree (adapters/base.py,
+        # pad_heads) and the pure-Ulysses path drops sequence pad rows exactly,
+        # so no head count or packed length limits the degree. World 2 keeps
+        # the measured rows untouched.
+        topo = Topology(world=world, ulysses=world, fsdp=topo.fsdp)
+        note = (f"{note}; ulysses{world} spreads the batch-1 render over all "
+                f"{world} ranks (heads padded to a multiple of {world} where needed)")
+
     if world % topo.model_parallel != 0:
         # Odd worlds cannot tile degree-2 rows. Pure Ring avoids head constraints
         # and keeps data parallel at one for batch-1 renders.
