diff --git a/src/dgx_monarch/adapters/base.py b/src/dgx_monarch/adapters/base.py
index bcbbebf..c6a6fbd 100644
--- a/src/dgx_monarch/adapters/base.py
+++ b/src/dgx_monarch/adapters/base.py
@@ -62,6 +62,39 @@ def sp_world() -> int:
     return get_sequence_parallel_world_size()
 
 
+def ulysses_world() -> int:
+    """The Ulysses degree of this process's sequence group (1 when unset)."""
+    try:
+        from xfuser.core.distributed import get_ulysses_parallel_world_size
+
+        return int(get_ulysses_parallel_world_size())
+    except Exception:  # noqa: BLE001  # no USP group: nothing is split by head
+        return 1
+
+
+def pad_heads(tensors, degree: int):
+    """Grow the head axis (dim 2 of `(B, L, H, D)`) to a multiple of `degree`.
+
+    Ulysses hands every rank an equal share of the heads, so a degree that does
+    not divide the head count (56 heads on 3 ranks) needs extra heads. They are
+    copies of the leading real heads, never zeros: a quantizing kernel scales
+    each head block by its own maximum, and an all-zero block would divide by
+    zero. Heads are independent, so the real heads' outputs are unchanged and
+    the copies are sliced off after the reverse all-to-all.
+    """
+    tensors = tuple(tensors)
+    heads = tensors[0].shape[2]
+    extra = -heads % degree if degree > 1 else 0
+    if not extra:
+        return tensors, 0
+    grown = []
+    for t in tensors:
+        reps = -(-extra // t.shape[2])
+        fill = t.repeat(1, 1, reps, 1)[:, :, :extra] if reps > 1 else t[:, :, :extra]
+        grown.append(torch.cat([t, fill], dim=2))
+    return tuple(grown), extra
+
+
 def sp_rank() -> int:
     from xfuser.core.distributed import get_sequence_parallel_rank
 
@@ -294,6 +327,8 @@ def _make_usp_attention_callable(
         if qkv_validator is not None:
             qkv_validator(q_l, k_l, v_l)
 
+        (q_l, k_l, v_l), extra_heads = pad_heads((q_l, k_l, v_l), ulysses_world())
+
         padded = bool(drop_rows) or bool(kv_drop_rows)
         ring_world = 0
         if padded or query_bias_groups or sequence_order is not None:
@@ -321,6 +356,8 @@ def _make_usp_attention_callable(
 
         if not isinstance(out, torch.Tensor):
             raise UnsupportedModelError("USP attention returned a non-tensor output")
+        if extra_heads:
+            out = out[:, :, :h]
         if skip_output_reshape:
             return out.transpose(1, 2)
         return out.reshape(b, -1, h * d)
