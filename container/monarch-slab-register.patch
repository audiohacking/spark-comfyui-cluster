@@ -16,6 +16,51 @@ log = logging.getLogger("dgx-monarch")
 
 _ALIGN = 256  # cuBLAS/vectorized-load friendly tensor alignment
 
+# cudaHostRegisterMapped. A slab is host memory that wrap_u8 labels CUDA, which
+# unified memory makes readable from the GPU. Kernels that ask the driver about
+# a pointer first (Triton's launcher does, so the INT8 GEMM option needs it)
+# refuse an address the driver has never seen. Registering the mapping makes the
+# driver know it; on this hardware the device address is the host address, so
+# every tensor already wrapped stays valid and its bytes do not move.
+_CUDA_HOST_REGISTER_MAPPED = 2
+_REGISTER_WARNED: set[str] = set()  # Process lifetime: one warning per distinct reason.
+
+
+def _cuda_register(base: int, capacity: int) -> bool:
+    """Register [base, base + capacity) with CUDA; False, with one warning, when it cannot."""
+    try:
+        import torch
+
+        if not torch.cuda.is_available():
+            return False
+        props = torch.cuda.get_device_properties(torch.cuda.current_device())
+        if not getattr(props, "is_integrated", False):
+            return False  # a discrete GPU never reads a slab in place
+        cudart = torch.cuda.cudart()
+        err = cudart.cudaHostRegister(base, capacity, _CUDA_HOST_REGISTER_MAPPED)
+        code = int(getattr(err, "value", err))
+        if code == 0:
+            return True
+        reason = f"cudaHostRegister returned {err}"
+    except Exception as exc:  # never fail a load over this
+        reason = f"cudaHostRegister raised {exc!r:.200}"
+    if reason not in _REGISTER_WARNED:
+        _REGISTER_WARNED.add(reason)
+        log.warning("slab arena: %s; pointer-checking kernels (the Triton INT8 GEMM) "
+                    "stay on their fallback for this slab", reason)
+    return False
+
+
+def _cuda_unregister(base: int) -> bool:
+    """Unregister a mapping _cuda_register registered; False when CUDA refuses."""
+    try:
+        import torch
+
+        err = torch.cuda.cudart().cudaHostUnregister(base)
+        return int(getattr(err, "value", err)) == 0
+    except Exception:
+        return False
+
 
