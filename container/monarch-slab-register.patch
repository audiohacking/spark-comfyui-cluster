diff --git a/tests/test_slab_arena_cuda_register.py b/tests/test_slab_arena_cuda_register.py
new file mode 100644
index 0000000..a1f4186
--- /dev/null
+++ b/tests/test_slab_arena_cuda_register.py
@@ -0,0 +1,88 @@
+"""A weight slab is registered with CUDA so pointer-checking kernels accept it.
+
+Runs on an integrated (unified-memory) CUDA device only, where wrap_u8 hands
+the GPU the slab's host mapping in place.
+"""
+import ctypes
+import sys
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available()
+    or not getattr(torch.cuda.get_device_properties(0), "is_integrated", False),
+    reason="needs an integrated CUDA device")
+
+
+_CU_POINTER_ATTRIBUTE_DEVICE_POINTER = 3
+
+
+def _attribute_device_pointer(ptr):
+    cuda = ctypes.CDLL("libcuda.so.1")
+    out = ctypes.c_uint64(0)
+    rc = cuda.cuPointerGetAttribute(ctypes.byref(out),
+                                    ctypes.c_int(_CU_POINTER_ATTRIBUTE_DEVICE_POINTER),
+                                    ctypes.c_uint64(ptr))
+    return rc, out.value
+
+
+def test_arena_registers_and_releases():
+    from dgx_monarch.actor.slab_arena import _Arena
+
+    arena = _Arena("test-slab-register", 1 << 20)
+    try:
+        assert arena.cuda_registered
+        rc, dev = _attribute_device_pointer(arena.base)
+        assert rc == 0 and dev == arena.base  # the driver knows it, at the host address
+    finally:
+        arena.close()
+    assert arena.closed and not arena.cuda_registered
+
+
+def test_triton_gemm_reads_a_slab_weight_bit_exactly():
+    import comfy_kitchen  # noqa: F401
+    from dgx_monarch.actor.slab_arena import _Arena
+    from dgx_monarch.actor.slab_wrap import wrap_u8
+    from dgx_monarch.kernels import int8_gemm_triton as v
+
+    if v.kitchen_version() not in v.VALIDATED_KITCHEN:
+        pytest.skip("comfy-kitchen outside the Triton kernel's validated set")
+    backend = sys.modules[v.TARGET]
+    real = getattr(backend._C, "_real", backend._C)
+    gemm = v.build_triton_gemm()
+    M, N, K = 1024, 512, 768
+    arena = _Arena("test-slab-gemm", N * K + 4096)
+    try:
+        w = wrap_u8(arena.base, N * K, cuda=True).view(torch.int8).view(N, K)
+        torch.manual_seed(0)
+        w.copy_(torch.randint(-127, 127, (N, K), dtype=torch.int8, device="cuda"))
+        x = torch.randint(-127, 127, (M, K), dtype=torch.int8, device="cuda")
+        xs = torch.rand(M, 1, device="cuda")
+        ws = torch.rand(N, 1, device="cuda")
+        bias = torch.empty(0, dtype=torch.bfloat16, device="cuda")
+        ref = torch.empty(M, N, dtype=torch.bfloat16, device="cuda")
+        real.cutlass_int8_dequant(*(t.__dlpack__(stream=-1) for t in (x, w, xs, ws, bias, ref)), 2, 0)
+        out = torch.empty_like(ref)
+        gemm(x, w, xs, ws, bias, out)  # raised "Pointer argument cannot be accessed" unregistered
+        torch.cuda.synchronize()
+        assert torch.equal(out, ref)
+        del w
+    finally:
+        arena.close()
+
+
+def test_still_referenced_mapping_keeps_its_registration():
+    from dgx_monarch.actor.slab_arena import _Arena
+
+    arena = _Arena("test-slab-held", 1 << 16)
+    view = memoryview(arena.mm)  # an exported buffer makes mmap.close() refuse
+    try:
+        with pytest.raises(RuntimeError):
+            arena.close()
+        assert not arena.closed
+        assert arena.cuda_registered  # put back for the tensors still reading it
+    finally:
+        view.release()
+        arena.close()
+    assert arena.closed and not arena.cuda_registered
