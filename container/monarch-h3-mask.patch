+def h3_mask_times(
+    mask_row_values: Any,
+    denoise_mask: Any,
+    audio_denoise_mask: Any,
+    latent_t: int,
+    lat_h: int,
+    lat_w: int,
+    sigma_v: torch.Tensor,
+    t_v: float,
+    t_a: float,
+    visual_cond_default: float,
+    audio_cond_default: float,
+) -> tuple[dict[str, float], torch.Tensor | None, torch.Tensor | None]:
+    """Times of the masked target rows, exactly as stock ``_forward`` derives them.
+
+    A mask value m puts a row at sigma = m * sigma_stream, so its model time is
+    ``1 - m * sigma``, clamped at the condition time for fully preserved rows.
+    When the kept rows share one value the stream's segment simply moves to
+    that time (first item, keyed by segment kind); otherwise the stream gets a
+    per-row time vector (second and third items, on the mask's device). The
+    arithmetic, dtypes, devices and pins are stock's line for line, so the
+    times, and the modulation rows built from them, are bit-identical.
+    """
+    seg_time: dict[str, float] = {}
+    video_rows_t = None
+    audio_rows_t = None
+    t_pin_v = max(t_v, visual_cond_default)
+    t_pin_a = max(t_a, audio_cond_default)
+    if denoise_mask is not None:
+        m = mask_row_values(denoise_mask[0, 0].to(torch.float32), latent_t, lat_h, lat_w)
+        if m is not None:
+            rows_t = (1.0 - m * sigma_v.to(m.device)).clamp(max=t_pin_v)
+            if rows_t.unique().numel() == 1:
+                seg_time["video"] = float(rows_t[0])
+            else:
+                video_rows_t = rows_t
+    if audio_denoise_mask is not None:
+        m = audio_denoise_mask[0, 0].to(torch.float32).reshape(-1)
+        if not bool((m >= 1.0 - 1e-3).all()):
+            sigma_a = 1.0 - t_a
+            rows_t = (1.0 - m * sigma_a).clamp(max=t_pin_a)
+            if rows_t.unique().numel() == 1:
+                seg_time["audio"] = float(rows_t[0])
+            else:
+                audio_rows_t = rows_t
+    return seg_time, video_rows_t, audio_rows_t
+
+
+def _rows_to_mod_index(rows_t: torch.Tensor, t_row: dict[float, int], tag: int) -> torch.Tensor:
+    """Per-row times -> per-row modulation indices, stock's ``rows_to_mod_index``."""
+    levels = rows_t.unique()
+    base = torch.tensor([t_row[v] * 3 + tag for v in levels.tolist()],
+                        dtype=torch.long, device=rows_t.device)
+    return base[torch.searchsorted(levels, rows_t)]
+
