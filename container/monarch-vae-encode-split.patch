+def test_the_worker_body_encodes_one_clip_as_the_stock_loop_does(comfy):
+    fsm = _h3(comfy, torch.float16)
+    clip = (torch.rand(1, 3, 17, 64, 96) * 2 - 1).to(torch.float16)
+    spec = SimpleNamespace(kind=H3_ENCODE, output_dtype=None)
+    expected = type(fsm)._adaptive_encode(fsm, type(fsm)._normalize_pixels(fsm, clip))
+    assert same_bytes(worker_body._run_unit(fsm, spec, clip), expected)
+    bare = comfy.minimax.MiniMaxH3VideoVAE(encoder=False, decoder=False)
+    with pytest.raises(worker_body.Decline):
+        worker_body._run_unit(bare, spec, clip)
+    assert H3_ENCODE in worker_body.KINDS
