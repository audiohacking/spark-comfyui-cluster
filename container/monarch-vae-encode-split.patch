+def test_the_encode_wrapper_is_keyed_and_off_switch(comfy, monkeypatch):
+    stock = comfy.sd.VAE.encode
+    monkeypatch.setattr(comfy.sd.VAE, "encode", stock)
+    vae_decode_route.install()
+    wrapped = comfy.sd.VAE.encode
+    assert getattr(wrapped, vae_decode_route._KEY, False) and wrapped.__wrapped__ is stock
+    vae_decode_route.install()  # never stacked
+    assert comfy.sd.VAE.encode is wrapped
+    monkeypatch.setenv("DGXM_VAE_ENCODE", "off")
+    assert not vae_decode_route.encode_enabled()
+    monkeypatch.setenv("DGXM_VAE_ENCODE", "auto")
+    assert vae_decode_route.encode_enabled()
+
