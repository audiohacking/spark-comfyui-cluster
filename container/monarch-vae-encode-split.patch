+
+
+def h3_encode_plan(fsm: Any, x: Any) -> list[Any]:
+    """Each clip ``MiniMaxH3VideoVAE.encode_temporal`` will normalize and hand ``_adaptive_encode``.
+
+    ``x`` is the stock loop's own input (``[B, C, T, H, W]`` in the VAE's
+    dtype, on the CPU under ComfyUI's chunked I/O). The clips are cut and the
+    last one padded with copies of its final frame, as the loop does; padding
+    is a copy, so it gives the same values on the CPU as on the GPU. The replay
+    checks each clip the loop really normalizes against these, so a change
+    upstream makes the encode run here, never a wrong latent.
+    """
+    import math
+
+    import torch
+
+    length = int(fsm.clip_length)
+    clips = []
+    for index in range(math.ceil(int(x.shape[2]) / length)):
+        clip = x[:, :, index * length:(index + 1) * length, :, :]
+        if clip.shape[2] < length:
+            pad = clip[:, :, -1:].repeat(1, 1, length - clip.shape[2], 1, 1)
+            clip = torch.cat([clip, pad], dim=2)
+        clips.append(clip)
+    return clips
+
+
+class H3EncodeReplay(_Replay):
+    """Stands in for ``MiniMaxH3VideoVAE._adaptive_encode`` during the stock ``encode_temporal``.
+
+    The stock loop hands it a normalized clip on the encode device. Unit k
+    matches only when that tensor equals the planned raw clip k normalized by
+    the model's own ``_normalize_pixels`` on the same device, byte for byte; a
+    Worker computes exactly that from the raw clip it was sent. Every clip has
+    the same shape (the last one is padded), so each remote result must equal
+    the driver's own unit 0 result in dtype and in every dimension.
+    """
+
+    def __init__(self, board: UnitBoard, plan: list[Any], fsm: Any, *, max_wait_s: float,
+                 check_interrupt: Callable[[], None] | None = None) -> None:
+        super().__init__(board, len(plan), max_wait_s=max_wait_s, check_interrupt=check_interrupt)
+        self._plan = plan
+        self._original = functools.partial(type(fsm)._adaptive_encode, fsm)
+        self._normalize = functools.partial(type(fsm)._normalize_pixels, fsm)
+        self._shape: tuple[int, ...] | None = None
+
+    def __call__(self, x: Any) -> Any:
+        import torch
+
+        def matches(unit: int) -> bool:
+            planned = self._plan[unit]
+            if x.shape != planned.shape or x.dtype != planned.dtype:
+                return False
+            return bool(torch.equal(x, self._normalize(planned.to(x.device))))
+
+        unit, remote, value = self._turn(matches)
+        if remote and self._usable(unit, value):
+            if self._shape is None or tuple(value.shape) == self._shape:
+                return value.to(device=x.device)
+            self._board.reject(unit, f"unit {unit} came back with shape {tuple(value.shape)} where "
+                                     f"the stock encode gives {self._shape}")
+        out = self._local_result(self._original(x))
+        if self._shape is None and hasattr(out, "shape"):
+            self._shape = tuple(int(n) for n in out.shape)
+        return out
