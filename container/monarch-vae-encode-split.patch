index 1c22afb..c2cf868 100644
--- a/src/dgx_monarch/vae_decode_plan.py
+++ b/src/dgx_monarch/vae_decode_plan.py
@@ -266,3 +266,68 @@ class H3Replay(_Replay):
             # The stock canvas lives on the decode device; so must this one.
             return value.to(device=z.device)
