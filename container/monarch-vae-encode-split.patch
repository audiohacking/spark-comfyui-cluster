diff --git a/tests/test_vae_encode_split_comfy.py b/tests/test_vae_encode_split_comfy.py
new file mode 100644
index 0000000..bfa72bc
--- /dev/null
+++ b/tests/test_vae_encode_split_comfy.py
@@ -0,0 +1,164 @@
+"""Real ComfyUI: a Worker-assisted MiniMax H3 encode is byte-identical to the stock encode.
+
+spark-comfyui-cluster patch. The reference is ComfyUI's own
+``MiniMaxH3VideoVAE.encode`` (``encode_temporal``: independent clip_length-frame
+clips, each spatially tiled and blended by ``tiled_encode``). The split replays
+that loop with simulated Worker ranks computing the clips they claim exactly as
+the Worker body does (``_adaptive_encode(_normalize_pixels(clip))``). The
+per-tile encoder is a deterministic stand-in, as in the decode tests; the
+hardware leg is a GB10 Worker's real clip equal to the driver's.
+"""
+from __future__ import annotations
+
+import time
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from dgx_monarch import vae_decode_route
+from dgx_monarch.actor import vae_decode as worker_body
+from dgx_monarch.vae_decode_families import H3_CHUNK, H3_ENCODE
+
+from test_vae_decode_split_comfy import _Ranks, _route, comfy, ranks, same_bytes  # noqa: F401
+
+
+def _h3(comfy, dtype=torch.float32):
+    """The real H3 VAE class, 64 px tiles, with a deterministic stand-in for the per-tile encoder."""
+    fsm = comfy.minimax.MiniMaxH3VideoVAE(encoder=False, decoder=False, tile_size=64, tile_overlap_min=16)
+    fsm.encoder = torch.nn.Identity()  # present; the stand-in below does the work
+
+    def moments(x):
+        # [B, 3, 17, H, W] -> [B, 48, 5, H/16, W/16], mixing time, space and channels
+        b, c, t, h, w = x.shape
+        pooled = torch.nn.functional.avg_pool3d(x.float(), kernel_size=(1, 16, 16))
+        first = pooled[:, :, :1]
+        rest = pooled[:, :, 1:].reshape(b, c, (t - 1) // 4, 4, h // 16, w // 16).mean(dim=3)
+        z = torch.cat([first, rest], dim=2)
+        out = torch.cat([torch.tanh(z * (0.5 + 0.03 * k) + 0.01 * k) for k in range(16)], dim=1)
+        return out.to(x.dtype)
+
+    slow = {"armed": False}
+
+    def first_slow(x):
+        if slow["armed"]:
+            slow["armed"] = False
+            time.sleep(0.5)
+        return moments(x)
+
+    fsm._encode_moments = first_slow
+    fsm.arm_slow_first = lambda: slow.update(armed=True)
+    return fsm.to(dtype)
+
+
+def _worker_clip(worker):
+    return lambda clip: type(worker)._adaptive_encode(worker, type(worker)._normalize_pixels(worker, clip))
+
+
+def _encode_route(fsm, remote):
+    route = _route(SimpleNamespace(first_stage_model=fsm), H3_CHUNK, list(range(1, remote + 1)))
+    route.encode = True
+    route.record.entry = "encode"
+    return route
+
+
+@pytest.mark.parametrize("frames", [22, 39, 124])
+@pytest.mark.parametrize("dtype", [torch.float32, torch.float16])
+@pytest.mark.parametrize("remote", [1, 2])
+def test_h3_encode_split_is_byte_identical(comfy, ranks, frames, dtype, remote):
+    torch.manual_seed(7)
+    x = (torch.rand(1, 3, frames, 80, 96) * 2 - 1).to(dtype)    # [-1, 1], as VAE.encode hands it
+    driver, worker = _h3(comfy, dtype), _h3(comfy, dtype)
+    stock = driver.encode(x)
+    ranks(_Ranks(_worker_clip(worker), delay_s=0.05))
+    route = _encode_route(driver, remote)
+    driver.arm_slow_first()
+    split = route.run(lambda: driver.encode(x))
+    assert same_bytes(split, stock)
+    assert "encode_temporal" not in driver.__dict__ and "_adaptive_encode" not in driver.__dict__
+    clips = -(-frames // driver.clip_length)
+    assert route.record.units == clips
+    assert route.record.local + sum(route.record.remote.values()) == clips
+    assert sum(route.record.remote.values()) >= 1 and not route.record.failures
+
+
+@pytest.mark.parametrize("failure", ["raise", "decline", "dtype", "shape"])
+def test_a_failing_rank_keeps_the_stock_bytes(comfy, ranks, failure):
+    x = torch.rand(1, 3, 56, 64, 64) * 2 - 1
+    driver, worker = _h3(comfy), _h3(comfy)
+    stock = driver.encode(x)
+    compute = _worker_clip(worker)
+    if failure == "shape":
+        compute = lambda clip: _worker_clip(worker)(clip)[..., :-1].contiguous()  # noqa: E731
+        fail = None
+    else:
+        fail = {"raise": lambda r, u: RuntimeError("sibling lost") if u >= 2 else None,
+                "decline": lambda r, u: "decline", "dtype": lambda r, u: "dtype"}[failure]
+    ranks(_Ranks(compute, fail=fail, delay_s=0.05))
+    route = _encode_route(driver, 1)
+    driver.arm_slow_first()
+    assert same_bytes(route.run(lambda: driver.encode(x)), stock)
+    assert route.record.local + sum(route.record.remote.values()) == route.record.units
+
+
+def test_a_single_clip_and_a_still_stay_here(comfy, ranks):
+    driver, worker = _h3(comfy), _h3(comfy)
+    ranks(_Ranks(_worker_clip(worker)))
+    for frames in (17, 1):
+        x = torch.rand(1, 3, frames, 64, 64) * 2 - 1
+        route = _encode_route(driver, 1)
+        assert same_bytes(route.run(lambda: driver.encode(x)), driver.encode(x))
+        assert sum(route.record.remote.values()) == 0
+
+
+def test_a_clip_the_loop_does_not_hand_over_as_planned_encodes_here(comfy, ranks, monkeypatch):
+    """A stock loop that cuts clips differently from the plan: the rest encodes here."""
+    from dgx_monarch import vae_decode_plan
+
+    x = torch.rand(1, 3, 56, 64, 64) * 2 - 1
+    driver, worker = _h3(comfy), _h3(comfy)
+    stock = driver.encode(x)
+    real = vae_decode_plan.h3_encode_plan
+    monkeypatch.setattr(vae_decode_plan, "h3_encode_plan", lambda fsm, x: [c.flip(2) for c in real(fsm, x)])
+    ranks(_Ranks(_worker_clip(worker)))
+    route = _encode_route(driver, 1)
+    assert same_bytes(route.run(lambda: driver.encode(x)), stock)
+    assert sum(route.record.remote.values()) == 0
+
