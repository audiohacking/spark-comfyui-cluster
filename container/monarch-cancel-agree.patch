diff --git a/src/dgx_monarch/actor/cancellation.py b/src/dgx_monarch/actor/cancellation.py
index c7dada2..4bcf1f1 100644
--- a/src/dgx_monarch/actor/cancellation.py
+++ b/src/dgx_monarch/actor/cancellation.py
@@ -19,6 +19,45 @@ def raise_if_sample_cancelled(cancel_event: threading.Event | None) -> None:
             "distributed render was cancelled before denoising")
 
 
+def cancel_agreed(cancel_event: threading.Event | None) -> bool:
+    """Whether ANY rank has seen this render's cancel, agreed by every rank.
+
+    The driver's cancel reaches each rank's event at its own moment, so a
+    rank-local check can stop one rank at a step boundary while its peer
+    starts the next step and waits in that step's first collective for a
+    partner that has left (until the NCCL timeout or a recycle). Every rank
+    of a render reaches the same boundaries in the same order (a topology's
+    degrees multiply to the world, topology.py), so a max all-reduce of the
+    local flags gives every rank the same answer at the same boundary: all
+    stop together, or all go on. One 4-byte collective per call. A world of
+    one, or no process group, keeps the local check.
+    """
+    local = cancel_event is not None and cancel_event.is_set()
+    try:
+        import torch
+        import torch.distributed as dist
+
+        if not (dist.is_available() and dist.is_initialized()) or dist.get_world_size() < 2:
+            return local
+        # NCCL reduces device tensors; other backends (gloo) host ones.
+        device = (torch.device("cuda", torch.cuda.current_device())
+                  if dist.get_backend() == "nccl" else torch.device("cpu"))
+        flag = torch.tensor([1 if local else 0], dtype=torch.int32, device=device)
+        dist.all_reduce(flag, op=dist.ReduceOp.MAX)
+        return bool(flag.item())
+    except ImportError:
+        return local
+
+
+def raise_if_sample_cancelled_agreed(cancel_event: threading.Event | None) -> None:
+    """``raise_if_sample_cancelled`` at a boundary every rank reaches, agreed."""
+    if cancel_agreed(cancel_event):
+        from .sampling import RenderCancelledError
+
+        raise RenderCancelledError(
+            "distributed render was cancelled before denoising")
+
+
 class CancellableSampleMixin:
     _gpu_lock: Any
     _on_gpu: Any
